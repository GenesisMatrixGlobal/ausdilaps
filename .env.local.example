# ─── Site ────────────────────────────────────────────────────────────
# MUST match the origin the site is actually served from. ausdilaps.com.au is STILL the old
# WordPress site until the domain cuts over — point this there too early and every staff
# invite email links to WordPress and 404s. Must also match Supabase Auth -> URL Configuration.
NEXT_PUBLIC_SITE_URL=https://ausdilaps.vercel.app
ADMIN_EMAIL=info@ausdilaps.com.au
SALES_NOTIFY_EMAIL=                 # optional CC for Tier-1 priority handoff
NEXT_PUBLIC_GA4_ID=G-81JV6BQ2R5
NEXT_PUBLIC_INTERCOM_APP_ID=i1k6ul4s

# ─── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@ausdilaps.com.au

# ─── Spam (Cloudflare Turnstile) ─────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Box (live sample reports sync — see docs/box-samples-sync.md) ────
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_SAMPLES_FOLDER_ID=405950982690

# ─── Storage (Cloudflare R2, S3-compatible) ──────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ausdilaps-reports
R2_ENDPOINT=                        # https://<account>.r2.cloudflarestorage.com

# ─── Salesforce (OAuth client-credentials) — dormant until enabled ───
SF_SYNC_ENABLED=false
# Must be the org's My Domain host. The client-credentials flow fails on login.salesforce.com
# with "invalid_grant: request not supported on this domain".
SF_LOGIN_URL=https://ausdilaps.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v60.0
# Sync To Salesforce (markup -> Box -> Quote). Only set these to override the defaults
# already in lib/markup-sync.ts — see docs/salesforce-markup-sync.md.
SF_OPPORTUNITY_BOX_FOLDER_FIELD=    # default Link_to_Box_Files__c
# The Quote's five markup slots are not configurable — the sync writes to the first empty
# one. See docs/salesforce-markup-sync.md for the field list.

# ─── Stripe (payment automation — deferred to Phase 7) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Survey Heading Uploader (staff tool, /staff (survey heading uploader — not yet built)) ───
# Separate Salesforce Connected App (JWT Bearer flow) from the SF_* vars above,
# which are for lead-sync client-credentials — do not merge these.
SF_SURVEY_LOGIN_URL=https://login.salesforce.com
SF_SURVEY_CLIENT_ID=
SF_SURVEY_USERNAME=surveyapi@ausdilaps.com.au
SF_SURVEY_PRIVATE_KEY=              # PEM contents; \n-escaped if kept on one line
SURVEY_HEADING_UPLOADER_ALLOW_UNAUTHED=false # local dev only; IGNORED in production

# ─── Lead engine ─────────────────────────────────────────────────────
LEAD_TEST_MODE=false                # true: insert to Supabase but route email to ADMIN_EMAIL, skip Salesforce

# ─── Property Sizing tool (staff estimator utility, /staff/estimators/tools/property-sizing) ──
ANTHROPIC_API_KEY=                            # enables reading addresses from a screenshot; without it, paste text
ANTHROPIC_OCR_MODEL=claude-haiku-4-5-20251001 # OCR model (haiku = cheap; bump to sonnet for dense/low-quality images)
PROPERTY_SIZING_ALLOW_UNAUTHED=false          # local dev only; IGNORED in production (staff must sign in)

# ─── Staff portal (/staff) + admin (/admin) ───────────────────────────
# Per-user Supabase Auth (magic link). No shared password any more — invite staff
# from /admin/staff. Uses the Supabase vars above plus NEXT_PUBLIC_SITE_URL (which
# builds the magic-link redirect, so it must match the deployed origin).
# One-time setup + the required Supabase Auth settings: docs/staff-portal.md
#
# DATABASE_URL is only needed to run `npm run migrate` (DDL). In Vercel the same
# value is provisioned as POSTGRES_URL_NON_POOLING.
DATABASE_URL=

# ─── KML Road Path Tracer (staff tool, /staff/inspectors/tools/kml-builder "Road segments" tab) ──
# Geocoding (Nominatim) + road geometry (Overpass) are both OpenStreetMap, free, no key.
KML_ROAD_TRACE_ALLOW_UNAUTHED=false           # local dev only; IGNORED in production (staff must sign in)
ROAD_SURVEY_ALLOW_UNAUTHED=false              # local dev only; IGNORED in production (staff must sign in)

# ─── Google Maps links + Site Markup (same tool — "Find Google Maps links" and ──
# "Site markup" tabs) ──────────────────────────────────────────────────────────
# PAID: Geocoding API + Directions API + Maps Static API, all billed per request
# (Google gives a $200/mo free credit — check current pricing before large batches).
# Needs all three APIs enabled + billing on your Google Cloud project. Key should be
# restricted to just those APIs (Google Cloud Console → Credentials → your key →
# API restrictions) and kept server-only — never NEXT_PUBLIC_-prefixed.
GOOGLE_MAPS_API_KEY=

# ─── Tender Watch (staff tool, /staff/accounts/tools/tender-watch + /admin/tender-watch) ──
# The nightly 8pm scan: RSS + monitored inbox → classify (Anthropic) → digest (Resend).
# Full setup, including the Entra app registration for the mailbox: docs/tender-watch.md
#
# NOTE these secrets FAIL CLOSED when unset (503) — deliberately unlike TURNSTILE_SECRET_KEY,
# which skips its check when absent. That is right for a public form with a honeypot and
# wrong for an endpoint that spends money on the Anthropic API and emails staff. There is
# no *_ALLOW_UNAUTHED hatch on the scan route: set CRON_SECRET locally and curl the header.
CRON_SECRET=                                  # REQUIRED, min 32 chars. Vercel Cron sends it as `Authorization: Bearer`.
TENDER_NOTIFY_EMAIL=                          # digest recipients, comma-separated; falls back to ADMIN_EMAIL
TENDER_FORWARD_ENABLED=false                  # week 1: run the whole pipeline, send nothing (shadow mode)
TENDER_FORWARD_UNTRUSTED=false                # forward mail from senders outside TENDER_TRUSTED_SENDER_DOMAINS
TENDER_TEST_MODE=false                        # true: classify + persist, but route the digest to ADMIN_EMAIL
TENDER_MAX_CLASSIFY_PER_RUN=60                # per-invocation ceiling, so an inbox flood can't run up a bill
TENDER_DAILY_CLASSIFY_BUDGET=200              # 24h circuit breaker
TENDER_CLASSIFY_MODEL=claude-opus-5           # ~$25-35/mo at 30-50 items/day, before the keyword prefilter
TENDER_WATCH_ALLOW_UNAUTHED=false             # READ routes only; local dev, IGNORED in production
#
# Blank = that source is disabled and shows as "Not configured" rather than "broken".
# Verify the feed URL by hand in a browser first: both tenders.gov.au and data.gov.au
# return 403 to unidentified automated fetches, and Vercel's IPs are likelier to be
# filtered than your laptop — so test it from a deployed preview, not localhost.
TENDER_AUSTENDER_FEED_URL=
TENDER_TRUSTED_SENDER_DOMAINS=buy.nsw.gov.au,hpw.qld.gov.au,tenders.gov.au
#
# Phase 2 — Microsoft Graph, app-only, for the tenders@ mailbox. Mail.Read as an
# APPLICATION permission reads every mailbox in the tenant until IT scopes it with an
# Exchange Online ApplicationAccessPolicy. That step is not optional.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
TENDER_MAILBOX=tenders@ausdilaps.com.au

# ─── Local sign-in bypass ──────────────────────────────────────────────
# 1 = skip the magic-link login on localhost and browse /staff and /admin as a
# synthetic superadmin. HARD-GATED on NODE_ENV, so it can never apply to a Vercel
# deployment (Vercel always sets NODE_ENV=production, previews included).
# Set to 0 when you need to test real sign-in, invites, or department scoping —
# with this on you are always a superadmin and will never see a permission bug.
STAFF_PREVIEW=0
